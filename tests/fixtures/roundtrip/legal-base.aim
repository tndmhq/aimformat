{"action":"add","after":"<p data-aim=\"0jna27un\" class=\"num-2 text-justify\">In this Addendum, the following terms shall have the meanings set out below and cognate terms shall be construed accordingly:<\/p>","anchor":{"after":"gr5algj2","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":14,"t":"2026-10-01T21:57:01Z","target":"0jna27un"}
{"action":"add","after":"<p data-aim=\"c4efr7lq\" class=\"num-3 text-justify\">\"<strong>Applicable Laws<\/strong>\" means (a) European Union or Member State laws with respect to any Company Personal Data in respect of which any Company Group Member is subject to EU Data Protection Laws; and (b) any other applicable law with respect to any Company Personal Data in respect of which any Company Group Member is subject to any other Data Protection Laws;<\/p>","anchor":{"after":"0jna27un","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":15,"t":"2026-10-01T21:57:01Z","target":"c4efr7lq"}
{"action":"add","after":"<p data-aim=\"9dn50smb\" class=\"num-3 text-justify\">\"<strong>Company Affiliate<\/strong>\" means an entity that owns or controls, is owned or controlled by or is or under common control or ownership with Company, where control is defined as the possession, directly or indirectly, of the power to direct or cause the direction of the management and policies of an entity, whether through ownership of voting securities, by contract or otherwise;<\/p>","anchor":{"after":"c4efr7lq","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":16,"t":"2026-10-01T21:57:01Z","target":"9dn50smb"}
{"action":"add","after":"<p data-aim=\"3ssqduk5\" class=\"num-3 text-justify\">\"<strong>Company Group Member<\/strong>\" means Company or any Company Affiliate;<\/p>","anchor":{"after":"9dn50smb","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":17,"t":"2026-10-01T21:57:01Z","target":"3ssqduk5"}
{"action":"add","after":"<p data-aim=\"vu5o81rb\" class=\"num-3 text-justify\">\"<strong>Company Personal Data<\/strong>\" means any Personal Data Processed by a Contracted Processor on behalf of a Company Group Member pursuant to or in connection with the Principal Agreement;<\/p>","anchor":{"after":"3ssqduk5","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":18,"t":"2026-10-01T21:57:01Z","target":"vu5o81rb"}
{"action":"add","after":"<p data-aim=\"9c5q8np1\" class=\"num-3 text-justify\">\"<strong>Contracted Processor<\/strong>\" means Vendor or a Subprocessor;<\/p>","anchor":{"after":"vu5o81rb","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":19,"t":"2026-10-01T21:57:01Z","target":"9c5q8np1"}
{"action":"add","after":"<p data-aim=\"g8vv8jrq\" class=\"num-3 text-justify\">\"<strong>Data Protection Laws<\/strong>\" means EU Data Protection Laws and, to the extent applicable, the data protection or privacy laws of any other country;<\/p>","anchor":{"after":"9c5q8np1","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":20,"t":"2026-10-01T21:57:01Z","target":"g8vv8jrq"}
{"action":"add","after":"<p data-aim=\"lt4po95g\" class=\"num-3 text-justify\">\"<strong>EEA<\/strong>\" means the European Economic Area;<\/p>","anchor":{"after":"g8vv8jrq","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":21,"t":"2026-10-01T21:57:01Z","target":"lt4po95g"}
{"action":"add","after":"<p data-aim=\"agnqf8js\" class=\"num-3 text-justify\">\"<strong>EU Data Protection Laws<\/strong>\" means EU Directive 95/46/EC, as transposed into domestic legislation of each Member State and as amended, replaced or superseded from time to time, including by the GDPR and laws implementing or supplementing the GDPR;<\/p>","anchor":{"after":"lt4po95g","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":22,"t":"2026-10-01T21:57:01Z","target":"agnqf8js"}
{"action":"add","after":"<p data-aim=\"vt2gskju\" class=\"num-3 text-justify\">\"<strong>GDPR<\/strong>\" means EU General Data Protection Regulation 2016/679;<\/p>","anchor":{"after":"agnqf8js","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":23,"t":"2026-10-01T21:57:01Z","target":"vt2gskju"}
{"action":"add","after":"<p data-aim=\"qgo8dg81\" class=\"num-3 text-justify\">\"<strong>Restricted Transfer<\/strong>\"<strong> <\/strong>means:<\/p>","anchor":{"after":"vt2gskju","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":24,"t":"2026-10-01T21:57:01Z","target":"qgo8dg81"}
{"action":"add","after":"<p data-aim=\"eten4kda\" class=\"num-4 text-justify\">a transfer of Company Personal Data from any Company Group Member to a Contracted Processor; or<\/p>","anchor":{"after":"qgo8dg81","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":25,"t":"2026-10-01T21:57:01Z","target":"eten4kda"}
{"action":"add","after":"<p data-aim=\"o700eb2f\" class=\"num-4 text-justify\">an onward transfer of Company Personal Data from a Contracted Processor to a Contracted Processor, or between two establishments of a Contracted Processor,<\/p>","anchor":{"after":"eten4kda","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":26,"t":"2026-10-01T21:57:01Z","target":"o700eb2f"}
{"action":"add","after":"<p data-aim=\"j2ih70qt\" class=\"text-justify\">in each case, where such transfer would be prohibited by Data Protection Laws (or by the terms of data transfer agreements put in place to address the data transfer restrictions of Data Protection Laws) in the absence of the Standard Contractual Clauses to be established under section [6.4.3 or] 12 below;<\/p>","anchor":{"after":"o700eb2f","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":27,"t":"2026-10-01T21:57:01Z","target":"j2ih70qt"}
{"action":"add","after":"<p data-aim=\"v2j8o5bd\" class=\"num-3 text-justify\">\"<strong>Services<\/strong>\" means the services and other activities to be supplied to or carried out by or on behalf of Vendor for Company Group Members pursuant to the Principal Agreement;<\/p>","anchor":{"after":"j2ih70qt","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":28,"t":"2026-10-01T21:57:01Z","target":"v2j8o5bd"}
{"action":"add","after":"<p data-aim=\"0mtegr88\" class=\"num-3 text-justify\">\"<strong>Standard<\/strong> <strong>Contractual Clauses<\/strong>\" means the contractual clauses set out in Annex 2, amended as indicated (in square brackets and italics) in that Annex and under section 13.4;<\/p>","anchor":{"after":"v2j8o5bd","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":29,"t":"2026-10-01T21:57:01Z","target":"0mtegr88"}
{"action":"add","after":"<p data-aim=\"0svr9i4d\" class=\"num-3 text-justify\">\"<strong>Subprocessor<\/strong>\" means any person (including any third party and any Vendor Affiliate, but excluding an employee of Vendor or any of its sub-contractors) appointed by or on behalf of Vendor or any Vendor Affiliate to Process Personal Data on behalf of any Company Group Member in connection with the Principal Agreement; and<\/p>","anchor":{"after":"0mtegr88","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":30,"t":"2026-10-01T21:57:01Z","target":"0svr9i4d"}
{"action":"add","after":"<p data-aim=\"lck0k1sc\" class=\"num-3 text-justify\">\"<strong>Vendor Affiliate<\/strong>\" means an entity that owns or controls, is owned or controlled by or is or under common control or ownership with Vendor, where control is defined as the possession, directly or indirectly, of the power to direct or cause the direction of the management and policies of an entity, whether through ownership of voting securities, by contract or otherwise.<\/p>","anchor":{"after":"0svr9i4d","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":31,"t":"2026-10-01T21:57:01Z","target":"lck0k1sc"}
{"action":"add","after":"<p data-aim=\"6e887ohf\" class=\"num-2 text-justify\">The terms, \"<strong>Commission<\/strong>\", \"<strong>Controller<\/strong>\", \"<strong>Data Subject<\/strong>\", \"<strong>Member State<\/strong>\", \"<strong>Personal Data<\/strong>\", \"<strong>Personal Data Breach<\/strong>\",<strong> <\/strong>\"<strong>Processing<\/strong>\" and \"<strong>Supervisory Authority<\/strong>\" shall have the same meaning as in the GDPR, and their cognate terms shall be construed accordingly.<\/p>","anchor":{"after":"lck0k1sc","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":32,"t":"2026-10-01T21:57:01Z","target":"6e887ohf"}
{"action":"add","after":"<p data-aim=\"g3blog3u\" class=\"num-2 text-justify\">The word \"<strong>include<\/strong>\" shall be construed to mean include without limitation, and cognate terms shall be construed accordingly.<\/p>","anchor":{"after":"6e887ohf","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":33,"t":"2026-10-01T21:57:01Z","target":"g3blog3u"}
{"action":"add","after":"<h1 data-aim=\"9bmks853\" class=\"num-1 text-justify\"><strong>Authority<\/strong><\/h1>","anchor":{"after":"g3blog3u","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":34,"t":"2026-10-01T21:57:01Z","target":"9bmks853"}
{"action":"add","after":"<p data-aim=\"di8j9r8m\" class=\"text-justify\">Vendor warrants and represents that, before any Vendor Affiliate Processes any Company Personal Data on behalf of any Company Group Member, Vendor's entry into this Addendum as agent for and on behalf of that Vendor Affiliate will have been duly and effectively authorised (or subsequently ratified) by that Vendor Affiliate.<\/p>","anchor":{"after":"9bmks853","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":35,"t":"2026-10-01T21:57:01Z","target":"di8j9r8m"}
{"action":"add","after":"<h1 data-aim=\"9ppp5bl0\" class=\"num-1 text-justify\"><strong>Processing of Company Personal Data<\/strong><\/h1>","anchor":{"after":"di8j9r8m","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":36,"t":"2026-10-01T21:57:01Z","target":"9ppp5bl0"}
{"action":"add","after":"<p data-aim=\"6l09i0uq\" class=\"num-2 text-justify\">Vendor and each Vendor Affiliate shall:<\/p>","anchor":{"after":"9ppp5bl0","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":37,"t":"2026-10-01T21:57:01Z","target":"6l09i0uq"}
{"action":"add","after":"<p data-aim=\"ktbf2t85\" class=\"num-3 text-justify\">comply with all applicable Data Protection Laws in the Processing of Company Personal Data; and<\/p>","anchor":{"after":"6l09i0uq","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":38,"t":"2026-10-01T21:57:01Z","target":"ktbf2t85"}
{"action":"add","after":"<p data-aim=\"dbisfetm\" class=\"num-3 text-justify\">not Process Company Personal Data other than on the relevant Company Group Member’s documented instructions unless Processing is required by Applicable Laws to which the relevant Contracted Processor is subject, in which case Vendor or the relevant Vendor Affiliate shall to the extent permitted by Applicable Laws inform the relevant Company Group Member of that legal requirement before the relevant Processing of that Personal Data.<\/p>","anchor":{"after":"ktbf2t85","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":39,"t":"2026-10-01T21:57:01Z","target":"dbisfetm"}
