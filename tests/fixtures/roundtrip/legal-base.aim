{"action":"add","after":"<p data-aim=\"iuem9gcp\" class=\"num-3 text-justify\">instructs Vendor and each Vendor Affiliate (and authorises Vendor and each Vendor Affiliate to instruct each Subprocessor) to:<\/p>","anchor":{"after":"sdl0fb4a","container":"body"},"author":{"id":"docx-import","type":"external"},"batch":"b1","explanation":"Imported from 'legal-addendum'","kind":"direct_edit","seq":41,"t":"2026-10-01T21:57:01Z","target":"iuem9gcp"}
