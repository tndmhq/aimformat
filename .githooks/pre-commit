#!/usr/bin/env bash
# pre-commit: the lint gate for aimformat (AGENTS.md, convention 8).
#
# Runs only for the parts the commit touches (deletions, renames and config
# changes included), and checks them the way CI does:
#   *.py in src/ tests/ scripts/ evals/   ruff check + ruff format --check on
#                                         the staged files
#   src/**.py                             mypy src
#   pyproject.toml                        all of the above on the whole tree
#   ts/**                                 prettier --check on the staged files,
#                                         tsc --noEmit (whole package on a
#                                         ts/ config change)
# Tests stay in CI. It checks, it never rewrites a file: on a failure it
# prints the command that fixes it. A missing tool is a failure, not a pass.
# It refuses when a check would read files that are not what is being
# committed (unstaged edits, untracked files). Never bypass it (--no-verify, -n, a
# core.hooksPath override): fix what it reports and commit again.
#
# Enable once per clone: git config core.hooksPath .githooks
# Python tools (ruff, mypy, pinned in the dev extra) are looked up in
# $AIMFORMAT_DEV_BIN, then ./.venv/bin, then `git config hooks.devbin`, then
# PATH. Bash 3.2 compatible. Paths with a newline, tab, quote or backslash in
# their name are not handled.
set -u

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
gitq() { git -c core.quotePath=false "$@"; }   # unquoted non-ASCII names
# --no-renames: a moved file shows as a deletion plus an addition, so the old
# path still triggers the checks of the tree it left.
changed=$(gitq diff --cached --no-renames --name-only --diff-filter=ACMRD)   # triggers
staged=$(gitq diff --cached --no-renames --name-only --diff-filter=ACMR)     # tool arguments
[ -n "$changed" ] || exit 0
# Files whose working copy is not what is being committed. The checks read
# the working tree, so they only vouch for this commit when none of these is
# something they read.
diffs=$( { gitq diff --no-renames --name-only; gitq ls-files --others --exclude-standard; } | sort -u)
devbin_cfg=$(git config --get hooks.devbin || true)
# The tools below must not inherit the commit's git environment.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX

fail=0
report() { # report <what failed> <output> <fix>
  fail=1
  printf '\n✗ %s\n' "$1" >&2
  [ -n "$2" ] && printf '%s\n' "$2" | tail -40 | sed 's/^/    /' >&2
  [ -n "$3" ] && printf '  fix: %s\n' "$3" >&2
}
check() { # check <label> <fix> cmd...
  local label=$1 fix=$2 out
  shift 2
  out=$("$@" 2>&1) || report "$label" "$out" "$fix"
}
quote() { local a out=""; for a in "$@"; do out="$out $(printf '%q' "$a")"; done; printf '%s' "${out# }"; }
has() { # has <list> <path>: exact line match
  printf '%s\n' "$1" | grep -Fxq -- "$2"
}

# --- what the commit touches -----------------------------------------------
pyc=0 src=0 pyfull=0 tsc=0 tsfull=0
while IFS= read -r f; do
  case "$f" in
    src/*.py) pyc=1; src=1 ;;
    tests/*.py | scripts/*.py | evals/*.py) pyc=1 ;;
    pyproject.toml) pyc=1; src=1; pyfull=1 ;;
  esac
  case "$f" in
    ts/package.json | ts/package-lock.json | ts/tsconfig*.json | ts/.prettierrc* | ts/.prettierignore)
      tsc=1; tsfull=1 ;;
    ts/*) tsc=1 ;;
  esac
done <<EOF
$changed
EOF

py=() ts=()
while IFS= read -r f; do
  case "$f" in
    src/*.py | tests/*.py | scripts/*.py | evals/*.py) py+=("$f") ;;
  esac
  case "$f" in ts/*) ts+=("${f#ts/}") ;; esac
done <<EOF
$staged
EOF

# --- refuse when a check would read something other than the commit -------
mismatch=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  hit=0
  case "$f" in
    src/*.py) { [ $src -eq 1 ] || has "$staged" "$f"; } && hit=1 ;;   # mypy src reads it all
    tests/*.py | scripts/*.py | evals/*.py) { [ $pyfull -eq 1 ] || has "$staged" "$f"; } && hit=1 ;;
    pyproject.toml) [ $pyc -eq 1 ] && hit=1 ;;                       # ruff and mypy config
    ts/*.ts | ts/*.mts | ts/*.cts | ts/tsconfig*.json | ts/package.json | ts/package-lock.json | \
    ts/.prettierrc* | ts/.prettierignore)
      [ $tsc -eq 1 ] && hit=1 ;;                                     # tsc sources, tool config
    ts/*) { [ $tsfull -eq 1 ] || has "$staged" "$f"; } && hit=1 ;;
  esac
  [ $hit -eq 1 ] && mismatch="$mismatch
  $f"
done <<EOF
$diffs
EOF
if [ -n "$mismatch" ]; then
  printf '\n✗ these files are not what you are committing, and a check would read them:%s\n' "$mismatch" >&2
  printf '  If they are your own edits, stage them (or commit them first).\n' >&2
  printf '  If they are not yours (someone else'"'"'s work in a shared checkout), do not\n' >&2
  printf '  stage, stash or discard them: commit from your own worktree, or ask.\n' >&2
  printf '\npre-commit: blocked. Never --no-verify.\n' >&2
  exit 1
fi

# --- tools -----------------------------------------------------------------
pybin() {
  local d
  if [ -n "${AIMFORMAT_DEV_BIN:-}" ]; then   # an explicit choice is never skipped
    [ -x "$AIMFORMAT_DEV_BIN/ruff" ] && [ -x "$AIMFORMAT_DEV_BIN/mypy" ] && { printf '%s' "$AIMFORMAT_DEV_BIN"; return 0; }
    return 1
  fi
  for d in "$root/.venv/bin" "$devbin_cfg"; do
    [ -n "$d" ] && [ -x "$d/ruff" ] && [ -x "$d/mypy" ] && { printf '%s' "$d"; return 0; }
  done
  if command -v ruff >/dev/null 2>&1 && command -v mypy >/dev/null 2>&1; then
    dirname "$(command -v ruff)"
    return 0
  fi
  return 1
}
need_node() { # node_modules/.bin scripts need node on PATH
  local d
  command -v node >/dev/null 2>&1 && return 0
  for d in ${HOME:+"$HOME/.local/share/fnm/aliases/default/bin"} /opt/homebrew/bin /usr/local/bin; do
    [ -x "$d/node" ] && { PATH="$d:$PATH"; export PATH; return 0; }
  done
  return 1
}

# --- python ----------------------------------------------------------------
if [ $pyc -eq 1 ]; then
  if ! bin=$(pybin); then
    report "python: ruff/mypy not found" "" \
      "pip install -e '.[dev]' in a .venv here, or set AIMFORMAT_DEV_BIN (or git config hooks.devbin) to a dir holding ruff and mypy"
  else
    if [ $pyfull -eq 1 ]; then targets=(src tests scripts); else targets=(${py[@]+"${py[@]}"}); fi
    if [ ${#targets[@]} -gt 0 ]; then
      check "ruff check" "$bin/ruff check --fix $(quote "${targets[@]}")" "$bin/ruff" check "${targets[@]}"
      check "ruff format" "$bin/ruff format $(quote "${targets[@]}")" "$bin/ruff" format --check "${targets[@]}"
    fi
    [ $src -eq 1 ] && check "mypy src" "fix the type errors above ($bin/mypy src)" "$bin/mypy" src
  fi
fi

# --- ts --------------------------------------------------------------------
if [ $tsc -eq 1 ]; then
  nb="$root/ts/node_modules/.bin"
  if ! need_node; then
    report "ts: node not found" "" "install node 24 or put it on PATH"
  elif [ ! -x "$nb/prettier" ] || [ ! -x "$nb/tsc" ] || ! (cd ts && "$nb/tsc" --version >/dev/null 2>&1); then
    report "ts: node_modules incomplete" "" "cd ts && npm ci"
  else
    ( cd ts || exit 1
      if [ $tsfull -eq 1 ]; then
        check "ts: prettier" "cd ts && npx prettier --write ." "$nb/prettier" --check .
      elif [ ${#ts[@]} -gt 0 ]; then
        check "ts: prettier" "cd ts && npx prettier --write $(quote "${ts[@]}")" \
          "$nb/prettier" --check --ignore-unknown "${ts[@]}"
      fi
      check "ts: tsc" "fix the type errors above (cd ts && npm run typecheck)" "$nb/tsc" --noEmit
      exit $fail ) || fail=1
  fi
fi

if [ $fail -ne 0 ]; then
  printf '\npre-commit: blocked. Fix the above, re-stage, commit again. Never --no-verify.\n' >&2
  exit 1
fi
exit 0
